# ─── Obligatorias ─────────────────────────────────────────────────────────────
JWT_SECRET=una-clave-larga-aleatoria-y-secreta-min-32-chars

# ─── OpenAI (IA premium) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxx

# ─── Stripe (pagos) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
# Para obtener el STRIPE_WEBHOOK_SECRET:
# 1. Dashboard Stripe → Developers → Webhooks → Add endpoint
# 2. URL: https://tu-app.onrender.com/api/webhook
# 3. Eventos: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ─── URL de tu app ────────────────────────────────────────────────────────────
APP_URL=https://tu-app.onrender.com

# ─── IDs de precios de Stripe ─────────────────────────────────────────────────
# Crear en Dashboard Stripe → Products → Add product
# Solo la Web: pago único 49,99€
STRIPE_PRICE_SOLO=price_xxxx
# Básico: suscripción mensual 9€/mes (la cuota de alta se añade en código)
STRIPE_PRICE_BASICO=price_xxxx
# Pro: suscripción mensual 25€/mes
STRIPE_PRICE_PRO=price_xxxx
# Business: suscripción mensual 60€/mes
STRIPE_PRICE_BUSINESS=price_xxxx
